{% load static %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ project_title | default("Django Demo") }}</title>
    
    <!-- Color palette CSS - loads from static files -->
    <link rel="stylesheet" href="{% static 'colors.css' %}">
    
    <style>
      body { 
        background: var(--background-color); 
        color: var(--primary-color); 
        font-family: system-ui, -apple-system, sans-serif;
        margin: 0;
        padding: 2rem;
      }
      .container {
        max-width: 800px;
        margin: 0 auto;
      }
      .cta { 
        background: var(--accent-color); 
        color: white;
        padding: 12px 16px; 
        border-radius: 8px; 
        border: none;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin: 1rem 0;
      }
      .cta:hover {
        opacity: 0.9;
      }
      .color-demo {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin: 2rem 0;
      }
      .color-swatch {
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
      }
      .primary { background: var(--primary-color); color: white; }
      .secondary { background: var(--secondary-color); color: white; }
      .accent { background: var(--accent-color); color: white; }
      .background { background: var(--background-color); color: var(--primary-color); border: 2px solid var(--primary-color); }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>🎨 Palette Demo Ready!</h1>
      <p>This Django template successfully loads your color palette. The CSS variables are working:</p>
      
      <div class="color-demo">
        <div class="color-swatch primary">
          <h3>Primary</h3>
          <code>var(--primary-color)</code>
        </div>
        <div class="color-swatch secondary">
          <h3>Secondary</h3>
          <code>var(--secondary-color)</code>
        </div>
        <div class="color-swatch accent">
          <h3>Accent</h3>
          <code>var(--accent-color)</code>
        </div>
        <div class="color-swatch background">
          <h3>Background</h3>
          <code>var(--background-color)</code>
        </div>
      </div>
      
      <a href="#" class="cta">This button uses accent color</a>
      
      <p><strong>Background:</strong> Uses <code>var(--background-color)</code></p>
      <p><strong>Text:</strong> Uses <code>var(--primary-color)</code></p>
      
      <hr style="margin: 2rem 0; border: 1px solid var(--primary-color); opacity: 0.3;">
      
      <h2>Ready for Development</h2>
      <p>Your generated Django app can now use these CSS variables in any template. The palette colors are automatically applied!</p>
    </div>
  </body>
</html>
