# bashvilleapi/codegen/templates/django/models.py.j2
from django.db import models
from django.contrib.auth.models import User


{% for entity in entities %}
class {{ entity.class_name }}(models.Model):
    """Generated model for {{ entity.class_name }}."""
    
    user = models.ForeignKey(
        User, 
        on_delete=models.CASCADE, 
        related_name="{{ entity.endpoint }}"
    )
    
    # Entity fields
{% for field in entity.fields %}
    {{ field.name }} = models.{{ field.type }}(
        {%- if field.type == "CharField" and field.max_length -%}
        max_length={{ field.max_length }}
        {%- endif -%}
        {%- if field.blank -%}, blank=True{%- endif -%}
        {%- if field.null -%}, null=True{%- endif -%}
    )
{% endfor %}

    # Relationships
{% for rel in entity.relationships %}
{% if rel.type == "ForeignKey" %}
    {{ rel.name }} = models.ForeignKey(
        "{{ rel.target }}", 
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        related_name="{{ rel.related_name }}"
    )
{% elif rel.type == "ManyToManyField" %}
    {{ rel.name }} = models.ManyToManyField(
        "{{ rel.target }}", 
        related_name="{{ rel.related_name }}", 
        blank=True
    )
{% endif %}
{% endfor %}
    
    created_at = models.DateTimeField(auto_now_add=True)

    def __str__(self):
        return f"{getattr(self, '{{ entity.display_field }}', self.pk)} by {self.user.username}"

    class Meta:
        ordering = ['-created_at']

{% endfor %}