from django.db import models
from django.contrib.auth.models import User

{% macro field_args(f) -%}
    {%- set args = [] -%}
    {%- if f.type == "CharField" and f.max_length -%}
        {%- set _ = args.append("max_length=" ~ f.max_length) -%}
    {%- endif -%}
    {%- if f.blank -%}{%- set _ = args.append("blank=True") -%}{%- endif -%}
    {%- if f.null -%}{%- set _ = args.append("null=True") -%}{%- endif -%}
    {{ args|join(", ") }}
{%- endmacro %}

{% for entity in entities %}
class {{ entity.class_name }}(models.Model):
    user = models.ForeignKey(User, on_delete=models.CASCADE, related_name="{{ entity.endpoint }}")

{% for field in entity.fields %}
    {{ field.name }} = models.{{ field.type }}({{ field_args(field) }})
{% endfor %}
{% for rel in entity.relationships %}
{% if rel.type == "ForeignKey" %}
    {{ rel.name }} = models.ForeignKey(
        "{{ rel.target }}",
        on_delete=models.SET_NULL,
        null=True, blank=True,
        related_name="{{ rel.related_name }}"
    )
{% elif rel.type == "ManyToManyField" %}
    {{ rel.name }} = models.ManyToManyField(
        "{{ rel.target }}",
        related_name="{{ rel.related_name }}",
        blank=True
    )
{% endif %}
{% endfor %}

    created_at = models.DateTimeField(auto_now_add=True)

    def __str__(self):
        return f"{getattr(self, '{{ entity.display_field }}', self.pk)} by {self.user.username}"

    class Meta:
        ordering = ['-created_at']
{% endfor %}