@tailwind base;
@tailwind components;
@tailwind utilities;

/* Custom styles with your color palette */
@layer base {
  :root {
    --color-primary: {{ color_palette.primary_hex }};
    --color-secondary: {{ color_palette.secondary_hex }};
    --color-accent: {{ color_palette.accent_hex }};
    --color-background: {{ color_palette.background_hex }};
  }
  
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background-color: var(--color-background);
    color: var(--color-primary);
    line-height: 1.6;
  }
}

@layer components {
  .btn-primary {
    @apply bg-primary text-white px-6 py-3 rounded-lg font-medium hover:opacity-90 transition-opacity;
  }
  
  .btn-secondary {
    @apply bg-secondary text-white px-6 py-3 rounded-lg font-medium hover:opacity-90 transition-opacity;
  }
  
  .btn-accent {
    @apply bg-accent text-white px-6 py-3 rounded-lg font-medium hover:opacity-90 transition-opacity;
  }
  
  .card {
    @apply bg-white rounded-xl shadow-lg p-6 border border-gray-100;
  }
  
  .container-main {
    @apply max-w-7xl mx-auto px-4 sm:px-6 lg:px-8;
  }
}
