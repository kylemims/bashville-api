import { useState } from 'react'
import { Card, Button } from '../components/UI'

export const Contact = () => {
  const [formData, setFormData] = useState({
    name: '',
    email: '',
    message: ''
  })
  const [isSubmitted, setIsSubmitted] = useState(false)

  const handleChange = (e) => {
    setFormData({
      ...formData,
      [e.target.name]: e.target.value
    })
  }

  const handleSubmit = (e) => {
    e.preventDefault()
    // In a real app, you would send this to your backend
    console.log('Form submitted:', formData)
    setIsSubmitted(true)
    
    // Reset form after 3 seconds
    setTimeout(() => {
      setIsSubmitted(false)
      setFormData({ name: '', email: '', message: '' })
    }, 3000)
  }

  if (isSubmitted) {
    return (
      <div className="min-h-screen bg-background flex items-center justify-center py-12">
        <Card className="max-w-md text-center">
          <div className="text-6xl mb-4">✅</div>
          <h2 className="text-2xl font-semibold text-primary mb-4">
            Message Sent!
          </h2>
          <p className="text-gray-600">
            Thank you for your message. This is a demo form - in a real application, 
            you would integrate with a backend service to handle form submissions.
          </p>
        </Card>
      </div>
    )
  }

  return (
    <div className="min-h-screen bg-background py-12">
      <div className="container-main">
        {/* Header */}
        <div className="text-center mb-12">
          <h1 className="text-4xl font-bold text-primary mb-4">
            Contact Us
          </h1>
          <p className="text-xl text-gray-600 max-w-2xl mx-auto">
            Get in touch with us. This is a demo contact form to show how forms work in your project.
          </p>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
          {/* Contact Form */}
          <Card>
            <h2 className="text-2xl font-semibold text-primary mb-6">
              Send us a Message
            </h2>
            
            <form onSubmit={handleSubmit} className="space-y-6">
              <div>
                <label htmlFor="name" className="block text-sm font-medium text-gray-700 mb-2">
                  Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  value={formData.name}
                  onChange={handleChange}
                  className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
                  placeholder="Your full name"
                />
              </div>

              <div>
                <label htmlFor="email" className="block text-sm font-medium text-gray-700 mb-2">
                  Email *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  value={formData.email}
                  onChange={handleChange}
                  className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
                  placeholder="your@email.com"
                />
              </div>

              <div>
                <label htmlFor="message" className="block text-sm font-medium text-gray-700 mb-2">
                  Message *
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows={5}
                  value={formData.message}
                  onChange={handleChange}
                  className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary transition-colors resize-vertical"
                  placeholder="Tell us what's on your mind..."
                />
              </div>

              <Button 
                type="submit" 
                variant="primary" 
                className="w-full text-lg py-4"
              >
                Send Message
              </Button>
            </form>
          </Card>

          {/* Contact Info & Integration Guide */}
          <div className="space-y-6">
            <Card>
              <h3 className="text-xl font-semibold text-primary mb-4">
                📧 Integration Guide
              </h3>
              <p className="text-gray-600 mb-4">
                This contact form is ready to integrate with your backend. Here's how:
              </p>
              
              <div className="space-y-3 text-sm">
                <div className="bg-gray-100 p-3 rounded">
                  <strong className="text-gray-700">1. Backend Integration:</strong>
                  <p className="text-gray-600 mt-1">
                    Replace the console.log in handleSubmit with an API call to your server.
                  </p>
                </div>
                
                <div className="bg-gray-100 p-3 rounded">
                  <strong className="text-gray-700">2. Email Services:</strong>
                  <p className="text-gray-600 mt-1">
                    Use services like EmailJS, Netlify Forms, or your own SMTP setup.
                  </p>
                </div>
                
                <div className="bg-gray-100 p-3 rounded">
                  <strong className="text-gray-700">3. Validation:</strong>
                  <p className="text-gray-600 mt-1">
                    Add client-side validation libraries like Formik or react-hook-form.
                  </p>
                </div>
              </div>
            </Card>

            <Card>
              <h3 className="text-xl font-semibold text-primary mb-4">
                🛠️ Form Features
              </h3>
              <ul className="space-y-3 text-gray-600">
                <li className="flex items-center">
                  <span className="w-2 h-2 bg-accent rounded-full mr-3"></span>
                  Responsive design that works on all devices
                </li>
                <li className="flex items-center">
                  <span className="w-2 h-2 bg-accent rounded-full mr-3"></span>
                  Form validation with required fields
                </li>
                <li className="flex items-center">
                  <span className="w-2 h-2 bg-accent rounded-full mr-3"></span>
                  Custom styling that matches your brand
                </li>
                <li className="flex items-center">
                  <span className="w-2 h-2 bg-accent rounded-full mr-3"></span>
                  Success state with user feedback
                </li>
                <li className="flex items-center">
                  <span className="w-2 h-2 bg-accent rounded-full mr-3"></span>
                  Accessible with proper labels and focus states
                </li>
              </ul>
            </Card>

            <Card className="bg-yellow-50 border-yellow-200">
              <h3 className="text-xl font-semibold text-primary mb-4">
                💡 Demo Notice
              </h3>
              <p className="text-gray-700">
                This is a demonstration form. Submissions are logged to the console 
                and not actually sent anywhere. Integrate with your preferred backend 
                service to make it functional.
              </p>
            </Card>
          </div>
        </div>
      </div>
    </div>
  )
}
