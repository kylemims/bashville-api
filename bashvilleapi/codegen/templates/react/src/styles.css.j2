:root{
  /* audience palette */
  --primary: {{ palette.primary }};
  --secondary: {{ palette.secondary }};
  --accent: {{ palette.accent }};
  --bg: {{ palette.background }};

  /* derived tokens (role-based) */
  --surface: color-mix(in oklab, var(--bg) 85%, #fff);
  --surface-2: color-mix(in oklab, var(--bg) 75%, #fff);
  --border: color-mix(in oklab, var(--bg) 60%, #fff);
  --text: color-mix(in oklab, var(--bg) 10%, #000);
  --muted: color-mix(in oklab, var(--text) 60%, var(--bg));
  --link: var(--accent);

  --radius: 10px;
  --shadow: 0 8px 24px rgba(0,0,0,.12);

  --space-1: 8px;
  --space-2: 12px;
  --space-3: 16px;
  --space-4: 24px;
}

*{ box-sizing:border-box }
html, body, #root{ height:100% }
body{
  margin:0;
  font-family: system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, "Helvetica Neue", Arial, "Noto Sans";
  background: var(--bg);
  color: var(--text);
}
.container{ max-width:1000px; margin:0 auto; padding:0 var(--space-2); }

a{ color: var(--link); text-decoration: none; }
a:hover{ text-decoration: underline; }

/* Reusable surfaces */
.card{
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.button{
  padding: 10px 14px;
  border-radius: 8px;
  border: 0;
  background: var(--accent);
  color: #fff;
  cursor: pointer;
  font-weight: 600;
}
.button:hover{ opacity: .95; }

/* Table styles (mobile friendly) */
.table{
  width: 100%;
  border-collapse: collapse;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}
.table th, .table td{ padding: 10px; border-bottom: 1px solid var(--border); }
@media (max-width: 640px){
  .table{ display: block; }
  .table thead{ display: none; }
  .table tr{
    display: block; margin-bottom: 12px;
    border: 1px solid var(--border); border-radius: var(--radius);
  }
  .table td{ display: flex; justify-content: space-between; padding: 12px; }
}

/* Navbar (aligns with Navbar.jsx.j2) */
.nav-root{ position: sticky; top: 0; z-index: 50; background: var(--primary); color:#fff; }
.nav-inner{ max-width:1000px; margin:0 auto; padding:12px 16px; display:flex; align-items:center; justify-content:space-between; }
.nav-brand{ display:flex; align-items:center; gap:10px; color:#fff; text-decoration:none; font-weight:600; letter-spacing:.2px; }
.nav-logo{ width:28px; height:28px; object-fit:contain; }
.nav-title{ font-size:18px; }
.nav-desktop{ display:none; gap:16px; }
.nav-link{ color:#fff; text-decoration:none; opacity:.95; }
.nav-link:hover{ text-decoration:underline; }
.nav-toggle{ background:transparent; border:0; font-size:22px; color:#fff; cursor:pointer; }
@media (min-width: 800px){
  .nav-toggle{ display:none; }
  .nav-desktop{ display:flex; }
}
.nav-overlay{ position:fixed; inset:0; background:rgba(0,0,0,.35); opacity:0; pointer-events:none; transition:.2s; }
.nav-overlay.show{ opacity:1; pointer-events:auto; }
.nav-drawer{ position:fixed; top:0; right:-320px; width:300px; height:100vh; background:#fff; color:#111; box-shadow:-6px 0 20px rgba(0,0,0,.2); transition:right .25s ease; display:flex; flex-direction:column; }
.nav-drawer.open{ right:0; }
.drawer-head{ display:flex; align-items:center; justify-content:space-between; padding:14px 16px; border-bottom:1px solid var(--border); }
.drawer-title{ font-weight:700; }
.drawer-close{ background:transparent; border:0; font-size:28px; cursor:pointer; line-height:1; }
.drawer-links{ display:flex; flex-direction:column; padding:8px; }
.drawer-link{ padding:12px 10px; border-radius:8px; color:#111; text-decoration:none; }
.drawer-link:hover{ background:#f2f2f2; }
.sr-only{ position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }

/* Hero (aligns with Hero.jsx.j2) */
.hero-root{ background: linear-gradient(0deg, var(--primary), var(--secondary)); color:#fff; }
.hero-inner{ max-width:1000px; margin:0 auto; padding:48px 16px; display:flex; flex-direction:column; align-items:center; text-align:center; gap:12px; }
.hero-logo{ width:72px; height:72px; object-fit:contain; filter: drop-shadow(0 4px 12px rgba(0,0,0,.25)); }
.hero-title{ font-size: clamp(28px, 6vw, 48px); letter-spacing:.3px; margin:6px 0; }
.hero-sub{ opacity:.95; margin:0 0 8px; }
.hero-cta{ display:inline-block; padding:10px 14px; border-radius:8px; background:var(--accent); color:#fff; text-decoration:none; font-weight:600; }
.hero-cta:hover{ opacity:.9; }